rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog collections (readable by anyone, modifiable by authenticated staff/admin)
    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /tickets/{ticketId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /drawAudits/{auditId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Raffle draws & cryptographic verification logs
    match /draws/{drawId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public winners showcase
    match /winners/{winnerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Community pool stats & global settings
    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Partner profiles (publicly viewable, editable by partner or admin)
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User accounts & private subcollections
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == "admin");
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == "admin");

      match /walletTransactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.role == "admin");
      allow write: if request.auth != null;
    }
  }
}
