rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = custom claim OR role field on the caller's own user document.
    // No email addresses are hardcoded — grant/revoke admin in Firestore
    // by setting users/{uid}.role to "admin" / "user".
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == "admin" ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )
      );
    }

    // Public catalog collections (readable by anyone, modifiable by authenticated staff/admin)
    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /tickets/{ticketId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /drawAudits/{auditId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Raffle draws & cryptographic verification logs
    match /draws/{drawId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public winners showcase
    match /winners/{winnerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Community pool stats & global settings
    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Partner profiles (publicly viewable, editable by partner or admin)
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User accounts & private subcollections
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /walletTransactions/{txId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /entries/{entryId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /notifications/{notifId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Public username registry for unique username validation
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // Email registry for unique email validation
    match /registeredEmails/{emailDoc} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if request.auth != null;
    }

    // Platform activity log — any signed-in user may append their own
    // actions; only admins (or the actor) may read.
    match /activityLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (isAdmin() || resource.data.actorId == request.auth.uid);
      allow update, delete: if false;
    }

    // Pending admin invites — managed by admins; the invited email may
    // read/consume its own invite on first sign-in.
    match /adminInvites/{inviteId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.email == request.auth.token.email);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.email == request.auth.token.email);
    }

    // Outbound mail queue for the Firestore "Trigger Email" extension.
    // Admins queue; the extension (Admin SDK) delivers regardless of rules.
    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Fraud case review states — admin only.
    match /fraudCases/{caseId} {
      allow read, write: if isAdmin();
    }
  }
}
