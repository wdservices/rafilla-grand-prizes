# Rafilla Grand Prizes — Environment Variables Template
# Copy this file to `.env` (do NOT commit .env to version control).
# Fill each value following the comments below.

# ──────────────────────────────────────────────────────────────────────────────
# 1. Site
# ──────────────────────────────────────────────────────────────────────────────

# Public-facing URL for the live site. Used in OpenGraph meta, email links,
# SSR canonical URL generation, and backend redirect validation.
VITE_SITE_URL=https://rafilla.com

# Display brand — rendered in footer, hero copy, transactional emails, auth
# transactional copy, receipts, and page <title> suffix.
VITE_SITE_NAME="Rafilla Grand Prizes"

# ──────────────────────────────────────────────────────────────────────────────
# 2. Firebase (Phase 2 — future authentication + Firestore)
#    Leave as placeholders until Firebase project is provisioned.
# ──────────────────────────────────────────────────────────────────────────────

# Firebase Web API key (Project Settings → General → Your apps → Web app).
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here

# Firebase Auth domain — same as <projectId>.firebaseapp.com OR a custom
# authorized domain configured in Firebase Console → Authentication → Settings.
VITE_FIREBASE_AUTH_DOMAIN=rafilla.firebaseapp.com

# GCP / Firebase Project ID.
VITE_FIREBASE_PROJECT_ID=rafilla

# Cloud Storage for Firebase bucket (used for winner photos, partner prize
# imagery, uploads from the admin panel, and KYC documents).
VITE_FIREBASE_STORAGE_BUCKET=rafilla.appspot.com

# Cloud Messaging sender ID (push notifications) — from Project Settings →
# Cloud Messaging → Web Push certificates.
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase App ID (1:xxxxxxx:web:xxxxxxx format) from Your apps → Web app.
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ──────────────────────────────────────────────────────────────────────────────
# 4. Cloudinary (used by admin panel · competitions / partners / user assets)
#    Both are PUBLIC (VITE_ prefixed) — use unsigned upload preset `ml_xxx`.
# ──────────────────────────────────────────────────────────────────────────────

# Cloudinary cloud name — found at top-left of the Cloudinary dashboard.
VITE_CLOUDINARY_CLOUD_NAME=rafilla

# Unsigned upload preset (recommended prefix `ml_`). Settings → Upload →
# Upload presets → "ml_default" or a custom preset unsigned preset.
# Admin competitions, partners, and asset galleries use this preset.
VITE_CLOUDINARY_UPLOAD_PRESET=ml_rafilla_assets

# ──────────────────────────────────────────────────────────────────────────────
# 5. Payment processors (Phase 2 — wallet funding + ticket checkout).
#    SERVER-ONLY keys. Do NOT prefix with VITE_ if the value should never be
#    exposed to client bundles. These are handled by the server entry only.
# ──────────────────────────────────────────────────────────────────────────────

# Paystack secret key (Dashboard → Settings → API Keys & Webhooks).
# Format: sk_live_xxx OR sk_test_xxx for sandbox.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave secret key (Settings → API Keys → Secret Key). Used as a
# secondary / fallback payment processor for regions where Paystack coverage
# is reduced. Format: FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# ──────────────────────────────────────────────────────────────────────────────
# 4. SMS & transactional email (Phase 2 — onboarding, OTP, winner alerts).
#    SERVER-ONLY.
# ──────────────────────────────────────────────────────────────────────────────

# Termii (Nigerian SMS provider) API key. Used for account OTPs, ticket
# confirmation, and winner text alerts.
TERMII_API_KEY=your_termii_api_key_here

# SendGrid API key (SG.xxx format) — used for transactional emails: account
# verification, password reset, ticket purchase receipt, winner contact,
# and marketing campaigns.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────────────────────
# 5. Admin & operations (Server-only — NOT exposed to the client bundle).
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated list of emails that receive super-admin-level access in the
# /admin/* routes. Used during auth middleware before role lookups hit the
# database.
ADMIN_EMAILS=admin@rafilla.com,superadmin@rafilla.com,ops@rafilla.com
