# Copy to .env and fill in values. Never commit .env with real secrets.
# Client-side (Vite) variables must be prefixed with VITE_ to reach the browser.

# --- Firebase (client) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary (client) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Paystack ---
# Public key (client-safe, pk_test_... or pk_live_...). Paste from Paystack Dashboard → Settings → API Keys.
VITE_PAYSTACK_PUBLIC_KEY=
# Secret key (SERVER ONLY, sk_test_... or sk_live_...). Never prefix with VITE_.
# Used by TanStack Start server functions to initialize/verify transactions.
PAYSTACK_SECRET_KEY=
# Firebase Admin service-account JSON (SERVER ONLY, single line).
# Firebase Console → Project Settings → Service Accounts → Generate new private key,
# then paste the entire JSON on one line. Required so the server can credit
# wallets after verified payments (clients are blocked from writing balances).
FIREBASE_SERVICE_ACCOUNT_JSON=
